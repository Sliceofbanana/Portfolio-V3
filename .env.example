# Contact form API (api/contact.js) — set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Required
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MY_EMAIL=you@example.com

# Optional: comma-separated origins allowed to call the API.
# Defaults to https://www.genesisjr.com, https://genesisjr.com, https://genesisjr.tech, https://www.genesisjr.tech, https://genesisjr.vercel.app
# (plus localhost outside production and the current Vercel preview URL).
ALLOWED_ORIGINS=

# Optional but recommended: durable rate limiting across serverless instances.
# Create a free Upstash Redis database (or add Vercel KV / Upstash from the Vercel Marketplace,
# which sets KV_REST_API_URL / KV_REST_API_TOKEN automatically). Without these, the API falls
# back to a per-instance in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
